# RailRefund Environment Variables

# Node environment (development, test, production)
NODE_ENV=development

# Salt for SHA-256 PNR hashing in logs and database (min 16 characters)
PNR_HASH_SALT=your-long-secure-salt-must-be-at-least-16-chars

# Rate Limiting (in-memory by default; Upstash Redis if configured)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Upstash Redis (optional; if omitted, in-memory rate limiter is used)
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Provider Settings
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_RETRIES=2

# Mock Provider (only permitted in dev/test, fails closed in production unless explicitly set to true)
ALLOW_MOCK_PROVIDER=true
